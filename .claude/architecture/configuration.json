{
  "services": {
    "example-service": {
      "mcp": "mcp__postgres_example__query",
      "flyway": "path/to/db/migration",
      "gitUrl": "https://github.com/org/repo.git",
      "defaultBranch": "main",
      "criticalTables": [],
      "highTables": []
    }
  },
  "filePatterns": {
    "*Entity.java": [
      "db-schemas",
      "db-semantics",
      "data-contracts"
    ],
    "*Repository.java": [
      "db-schemas",
      "db-semantics",
      "data-contracts"
    ],
    "db/migration/**": [
      "db-schemas"
    ],
    "*.sql": [
      "db-schemas"
    ]
  },
  "semantics": {
    "weights": {
      "explicit_label_or_comment": 2.0,
      "dto_class_name": 1.8,
      "business_logic": 1.5,
      "context_inference": 1.3,
      "test_assertion": 1.2,
      "indirect_ref": 0.7
    },
    "refLevels": {},
    "confidence": {},
    "nullInterpretation": {},
    "tiers": {}
  }
}