{
    "services": {
        "example-be": {
            "path": "/path/to/be",
            "type": "BACKEND",
            "mcp_server": "mcp__postgres_example__query",
            "critical_tables": [],
            "high_priority_tables": []
        },
        "example-fe": {
            "path": "/path/to/fe",
            "type": "FRONTEND"
        },
        "example-mobile": {
            "path": "/path/to/mobile",
            "type": "MOBILE"
        }
    },
    "discovery_patterns": {
        "BACKEND": {
            "include": [
                "*Controller*.java",
                "*Feign*.java",
                "*KafkaListener*",
                "db/migration/**",
                "*.sql",
                "*Entity*.java"
            ],
            "exclude": ["**/test/**", "**/target/**"]
        },
        "FRONTEND": {
            "include": [
                "src/api/**",
                "src/components/**",
                "package.json",
                "*.tsx",
                "src/store/**"
            ],
            "exclude": ["node_modules/**", "dist/**"]
        },
        "MOBILE": {
            "include": [
                "app/src/main/**",
                "ios/**",
                "src/api/**",
                "src/screens/**"
            ],
            "exclude": ["**/build/**", "**/Pods/**"]
        }
    },
    "mapping_rules": {
        "JPA": [
            "@Entity",
            "@Table",
            "@Column",
            "@ManyToOne"
        ],
        "React": [
            "useQuery",
            "axios.get",
            "useEffect"
        ],
        "Flutter": [
            "Provider",
            "BlocBuilder",
            "MaterialApp"
        ]
    },
    "semantics": {
        "weights": {
            "explicit_label_or_comment": 2.0,
            "dto_class_name": 1.8,
            "business_logic": 1.5,
            "context_inference": 1.3,
            "test_assertion": 1.2,
            "indirect_ref": 0.7
        },
        "ref_levels": {
            "DEAD": [0, 0],
            "ISOLATED": [1, 1],
            "LOW": [2, 5],
            "NORMAL": [6, 15],
            "HIGH": [16, null]
        },
        "confidence_thresholds": {
            "HIGH": {"weightedPct": 0.70, "minSources": 3, "mismatch": false},
            "MEDIUM": {"weightedPct": 0.50, "minSources": 2, "mismatch": "minor"},
            "LOW": {"weightedPct": 0.0, "minSources": 1, "mismatch": true},
            "CONFLICT": {"condition": "2+ sources contradict"}
        },
        "null_interpretation": {
            "under5pct": "거의 항상 NULL -> 특수 조건에서만",
            "5to20pct": "조건부 (특정 상태에서만 세팅)",
            "20to80pct": "선택적",
            "80to99pct": "거의 필수 (빠지면 버그 가능성)",
            "100pct": "필수"
        }
    }
}
