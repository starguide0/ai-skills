{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Architecture Refresh Config Schema",
  "type": "object",
  "properties": {
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "type": { "enum": ["BACKEND", "FRONTEND", "MOBILE"] },
          "mcp": { "type": ["string", "null"] },
          "critical_tables": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["path", "type"]
      }
    },
    "discovery_patterns": {
      "type": "object",
      "description": "Any key here (e.g., 'jpa', 'kafka', 'grpc') is treated as a pattern group for the engine to iterate.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "include": { "type": "array", "items": { "type": "string" } },
          "exclude": { "type": "array", "items": { "type": "string" } },
          "annotations": { "type": "array", "items": { "type": "string" } },
          "keywords": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "mapping_rules": {
      "type": "object",
      "properties": {
        "db_mapping_steps": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "required": ["services", "discovery_patterns", "mapping_rules"]
}
